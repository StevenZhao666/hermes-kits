@echo off
setlocal
cd /d "%~dp0"
title Network Optimizer

set "NETOPT_DIR=%~dp0"
set "NETOPT_BAT=%~f0"
set "NETOPT_MODE=optimize"
if /i "%~1"=="/restore" set "NETOPT_MODE=restore"
set "NETOPT_PS=%TEMP%\netopt_run.ps1"

rem ---- unpack embedded PowerShell body (pure ASCII base64, code-page independent) ----
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=(Select-String -LiteralPath $env:NETOPT_BAT -Pattern '^::B64:' -Encoding ASCII | ForEach-Object { $_.Line.Substring(6) }) -join ''; if (-not $b) { exit 3 }; [IO.File]::WriteAllText($env:NETOPT_PS, [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b)), (New-Object Text.UTF8Encoding $true))"
if errorlevel 1 (
    echo   [X] Failed to unpack the internal script. File may be damaged.
    echo.
    pause
    exit /b 1
)

rem ---- elevation ----
net session >nul 2>&1
if errorlevel 1 (
    powershell -NoProfile -ExecutionPolicy Bypass -File "%NETOPT_PS%" -Stage elevate
    exit /b
)

powershell -NoProfile -ExecutionPolicy Bypass -File "%NETOPT_PS%"
set "RC=%errorlevel%"
del "%NETOPT_PS%" >nul 2>&1
exit /b %RC%

